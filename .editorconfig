root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,props,json,jsonc,js,jsx,ts,tsx,css,html,md,yml,yaml,toml}]
indent_style = space
indent_size = 2

[*.cs]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[**/Persistence/Migrations/*.cs]
# EF Core generates short-lived array expressions for index column lists.
dotnet_diagnostic.CA1861.severity = none
