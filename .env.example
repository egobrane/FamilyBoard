# Local Docker Compose values only. Copy this file to .env and replace the
# placeholders. Never use these example values in a deployed environment.
POSTGRES_DB=family_dashboard
POSTGRES_USER=family_dashboard
POSTGRES_PASSWORD=replace-with-a-local-development-password
API_PORT=8080
FRONTEND_PORT=5173

# Optional local backend authentication. Keep disabled until a local Google web
# client is configured; placeholders are never valid deployment credentials.
Authentication__Google__Enabled=false
Authentication__Google__ClientId=replace-with-a-local-google-client-id
Authentication__Google__ClientSecret=replace-with-a-local-google-client-secret
Authentication__FrontendOrigin=http://localhost:5173
DataProtection__UseAzure=false

# Optional public policy overrides. These are not secrets.
Invitations__Lifetime=7.00:00:00
Invitations__PendingCookieLifetime=00:30:00

# Required before using shared-display parent controls. Generate a random
# 32-byte value and base64 encode it; never reuse the example text.
ParentAccess__Enabled=true
ParentAccess__Pepper=replace-with-base64-encoded-32-byte-random-value

# Optional, separate Google Calendar OAuth client. Tokens remain backend-only.
GoogleCalendar__Enabled=false
GoogleCalendar__EventCreationEnabled=false
GoogleCalendar__ClientId=replace-with-calendar-google-client-id
GoogleCalendar__ClientSecret=replace-with-calendar-google-client-secret
GoogleCalendar__CallbackUrl=http://localhost:8080/api/integrations/google-calendar/callback

# Portable recurring-chore generator policy. Run the one-shot local command with:
# docker compose --profile tools run --rm chore-generator
ChoreGeneration__HorizonHours=36
ChoreGeneration__MaximumAssignmentsPerRun=100
